# AniList API client - create one at https://anilist.co/settings/developer
# The redirect URL registered there must be exactly:
#   http://localhost:3000/auth/callback   (local)
#   https://<your-domain>/auth/callback   (production)
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=

# Optional. Overrides the redirect URI that is sent to AniList. It must match
# the URL registered in the AniList developer settings byte for byte, otherwise
# AniList answers with "invalid_client".
# ANILIST_REDIRECT_URI=http://localhost:3000/auth/callback
